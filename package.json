{
  "name": "pitch",
  "private": true,
  "version": "0.0.0",
  "description": "Football career simulator. Live at pitch-sim.com.",
  "scripts": {
    "dev": "node tools/make-entry.mjs && vite",
    "build": "npm run build:legacy && npm run build:app",
    "build:legacy": "python3 src/build.py",
    "build:app": "node tools/make-entry.mjs && vite build",
    "preview": "npm run build:app && vite preview --port 4173 --strictPort",
    "validate": "python3 src/validate_p0.py",
    "test": "vitest run && npm run check:ui-emoji && npm run balance:match:check",
    "check:accents": "node tools/check-club-accents.mjs",
    "check:ui-emoji": "node tools/check-ui-emoji.mjs",
    "balance:match": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/match-balance-report.mjs",
    "balance:match:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/match-balance-report.mjs --check",
    "balance:match:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/match-balance-report.mjs --write",
    "balance:match:deep": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/match-balance-t7.mjs",
    "balance:match:deep:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/match-balance-t7.mjs --matches=100 --check",
    "audit:rosters": "node tools/audit-rosters.mjs",
    "reconcile": "node tools/reconcile.mjs",
    "refresh:players": "node tools/refresh-player-data.mjs && node tools/csv-to-league.mjs",
    "refresh:players:dry-run": "node tools/refresh-player-data.mjs --dry-run",
    "generate:leagues": "node tools/csv-to-league.mjs",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
